# Set these in the deployment platform's secret-variable manager, never in source control.
NODE_ENV=production
PORT=3000
# Mount a persistent private volume here in production; this directory must be outside the public web root.
DATA_DIR=/data

# Start with Daraja sandbox. Obtain credentials from Safaricom Daraja for your own app.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Exact HTTPS URL after deploying: https://YOUR-DOMAIN/api/mpesa/callback
MPESA_CALLBACK_URL=
# Live payments remain disabled unless you explicitly set this after production review.
ALLOW_LIVE_PAYMENTS=false
# Random long secret used to protect product-catalog management endpoint.
ADMIN_API_TOKEN=
